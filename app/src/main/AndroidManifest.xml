<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StevesAdventureAndMystery"
        tools:ignore="ExtraText">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StevesAdventureAndMystery"
            android:screenOrientation="landscape"
            android:excludeFromRecents="true"
            tools:ignore="DiscouragedApi">  <!-- tools:ignore is now an attribute of activity -->
            <!-- The comment "<!- Add this line -->" can be placed here or on its own line if needed, but not interrupting the tag itself -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- This closes the <activity> tag -->
    </application>
    <!-- The extra </manifest> tag has been removed -->
</manifest>